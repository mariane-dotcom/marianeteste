# Banco de dados (Vercel Postgres / Neon / Supabase com Prisma)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend - envio do guia em PDF
RESEND_API_KEY=""
RESEND_FROM="R21 Empreendimentos <contato@r21empreendimentos.com>"

# URL pública (usada em links absolutos de e-mail)
NEXT_PUBLIC_SITE_URL="https://r21empreendimentos.com"

# Destino de notificação de leads A (consultor sênior)
NOTIFY_LEAD_A_EMAIL="contato@r21empreendimentos.com"

# CRM (Fase 4) — modo "webhook" envia POST para o CRM_WEBHOOK_URL (Zapier/Make/n8n/etc).
# Quando definir o CRM final (RD Station, HubSpot, Pipedrive), ajustar aqui.
CRM_MODE="noop"
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_SECRET=""

# Cron de nutrição (chamado pela Vercel diariamente — ver vercel.json)
CRON_SECRET=""
