# Banco de dados — Postgres (Neon ou Supabase em produção)
DATABASE_URL=

# Resend (e-mail transacional)
RESEND_API_KEY=
# From verificado no Resend (ex: "R21 <contato@r21.com.br>"). Default: onboarding@resend.dev
RESEND_FROM_EMAIL=

# E-mail interno que recebe notificação de leads classificação A
INTERNAL_NOTIFY_EMAIL=

# Secret para assinatura HMAC dos tokens de download do guia. Gere com
#   openssl rand -hex 32
LEAD_TOKEN_SECRET=

# URL pública do site (usada nos e-mails). Em prod, definir como https://r21.com.br
NEXT_PUBLIC_SITE_URL=

# Analytics (públicos — usados no client)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# CRM — "console" (default, só loga) ou "rd-station"
CRM_PROVIDER=console
# Quando CRM_PROVIDER=rd-station: token de acesso do RD Station
CRM_RD_STATION_TOKEN=

# Secret usado para autenticar o cron diário de nutrição na Vercel.
# Gere com: openssl rand -hex 24
CRON_SECRET=

# Senha do dashboard /admin. Sem ela, o login sempre falha.
ADMIN_PASSWORD=

# Secret usado pelo webhook que o CRM dispara quando um lead fecha/perde.
# Use header "x-webhook-secret: <valor>" no CRM ao configurar o webhook.
WEBHOOK_CRM_SECRET=
