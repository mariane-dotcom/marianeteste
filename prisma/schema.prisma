generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Classificacao {
  A
  B
  C
}

enum Objetivo {
  morar
  investir
  ambos
}

enum FaixaCapital {
  ate_300k
  de_300k_700k
  de_700k_1_5M
  acima_1_5M
}

enum Horizonte {
  ate_12m
  de_12m_36m
  acima_36m
}

model Lead {
  id             String              @id @default(cuid())
  nome           String
  email          String
  telefone       String
  objetivo       Objetivo
  faixaCapital   FaixaCapital
  horizonte      Horizonte
  score          Int
  classificacao  Classificacao
  origem         String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  userAgent      String?
  crmProvider    String?
  crmContactId   String?
  createdAt      DateTime            @default(now())
  nurturingSteps NurturingDispatch[]

  @@index([email])
  @@index([classificacao, createdAt])
}

model NurturingDispatch {
  id     String   @id @default(cuid())
  leadId String
  step   Int
  sentAt DateTime @default(now())
  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, step])
  @@index([sentAt])
}
